# Dependencies
node_modules/

# Build and tool output
dist/

# EXCEPT the built NUI, which ships with the resource. An operator installs this
# and starts a server; there is no build step in that sequence, and shipping only
# source would put Node and a toolchain on the critical path for a notification.
!web/dist/
!web/dist/**
build/
.cache/
*.tsbuildinfo
coverage/

# Local operator values. Bootstrap files are committed with blank placeholders
# only; a filled-in copy must never be committed back.
config.local.lua
*.local.lua
server.cfg
secrets.*

# Editor and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
